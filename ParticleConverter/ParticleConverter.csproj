<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>ParticleConverter.App</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <LangVersion>12</LangVersion>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release</Configurations>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/kemo14331/Particle-Converter</RepositoryUrl>
    <Authors>Kemo431</Authors>
    <Copyright>Kemo431</Copyright>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HelixToolkit.SharpDX.Core.Wpf" Version="2.27.3" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParticleConverter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <!--
    The language files are compiled as Pages (so ResourceDictionary Source="lang/xx.xaml"
    resolves) *and* copied to the output directory, because Load_Language enumerates
    lang\*.xaml on disk to build the language dropdown. Both are required.
  -->
  <ItemGroup>
    <Page Update="lang\*.xaml">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Page>
    <LangFile Include="lang\*.xaml" />
  </ItemGroup>

  <Target Name="CopyLanguageFiles" AfterTargets="Build">
    <Copy SourceFiles="@(LangFile)" DestinationFolder="$(TargetDir)lang" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish copies from its own item list, not TargetDir, so this has to be repeated. -->
  <Target Name="CopyLanguageFilesOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(LangFile)" DestinationFolder="$(PublishDir)lang" SkipUnchangedFiles="true" />
  </Target>

</Project>
